# npm start loads .env from App; existing environment variables take precedence.
# Railway sets PORT automatically. For two services, set API PORT=8080 explicitly.
PORT=5173
HOST=127.0.0.1
SERVE_UI=true
# Leave empty for the combined UI/API service.
# UI service only, Railway: http://${{server.RAILWAY_PRIVATE_DOMAIN}}:${{server.PORT}}
# Local split services: http://127.0.0.1:8081
INTERNAL_API_URL=
# Docker sets NODE_ENV=production and HOST=:: automatically.
NODE_ENV=development
