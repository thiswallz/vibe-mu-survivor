{
  "name": "mu-survivor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "Local MU Survivor WebGL proof of concept",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "npm run build:packages && node scripts/dev.mjs",
    "build:packages": "tsc -b",
    "typecheck": "tsc -b && tsc -p apps/ui --noEmit",
    "build": "npm run typecheck && npm run build --workspace @mu-survivor/ui",
    "serve": "node apps/server/dist/index.js --production",
    "test": "npm run build:packages && node --test tests/*.test.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/three": "0.180.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
